{
  "version": 1,
  "project": { "name": "example-fe-app", "package_manager": "pnpm", "monorepo": false },
  "jira": {
    "project_keys": ["PROJ"],
    "branch_template": "feature/{jira_key}-{slug}"
  },
  "checks": {
    "typecheck": "pnpm typecheck",
    "lint": "pnpm lint",
    "test": "pnpm test --run",
    "build": "pnpm build"
  },
  "dev": { "start": "pnpm dev", "url": "http://localhost:5173", "storybook_url": null },
  "visual_qa": {
    "viewports": [
      { "name": "mobile", "width": 375, "height": 812 },
      { "name": "desktop", "width": 1440, "height": 900 }
    ],
    "mocks": "none"
  },
  "tiers": {
    "trivial": { "max_files": 3, "max_loc": 60 },
    "small": { "max_files": 8, "max_loc": 300 },
    "medium": { "max_files": 25, "max_loc": 1200 }
  },
  "risk": {
    "globs": {
      "auth": ["src/**/auth/**", "src/**/guards/**", "src/**/interceptors/**", "src/**/session/**"],
      "api_client": ["src/**/api/**", "src/**/services/**", "*.gen.ts", "src/**/query-client.*"],
      "state": ["src/**/store/**", "src/**/slices/**"],
      "design_tokens": ["tailwind.config.*", "src/**/theme/**", "src/**/tokens/**", "src/**/*.css"],
      "build_config": ["vite.config.*", "tsconfig*.json", "turbo.json", ".env*", "service-worker.*"],
      "dependencies": ["package.json", "pnpm-lock.yaml", "package-lock.json", "yarn.lock"],
      "i18n_analytics": ["src/**/locales/**", "src/**/i18n/**", "src/**/analytics/**"],
      "routing_root": ["src/router/**", "src/routes/**", "src/App.tsx"]
    },
    "content_patterns": ["dangerouslySetInnerHTML", "window.location"],
    "blast_radius": { "source": "pilothify", "edges": "EXTRACTED", "depth": 2, "affected_threshold": 15, "cross_package": true }
  },
  "rollout": { "mode": "full" },
  "graph": { "enforce": "warn", "git_hooks": true },
  "versions": { "speckit": "1.4.2", "pilothify": "0.1.7" },
  "data": { "commit_intake_summary": true }
}
