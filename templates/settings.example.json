      "mcp__atlassian__lookup*",
      "mcp__atlassian__fetch",
      "mcp__atlassian__atlassianUserInfo",
      "mcp__claude_ai_Atlassian__get*",
      "mcp__claude_ai_Atlassian__search*",
      "mcp__claude_ai_Atlassian__lookup*",
      "mcp__claude_ai_Atlassian__fetch",
      "mcp__claude_ai_Atlassian__atlassianUserInfo",
      "mcp__plugin_figma_figma__create_session",
      "mcp__plugin_figma_figma__get_design_context",
      "mcp__plugin_figma_figma__get_metadata",
      "mcp__plugin_figma_figma__get_screenshot",
      "mcp__plugin_figma_figma__get_variable_defs",
      "mcp__plugin_figma_figma__get_code_connect_map",
