{
  "name": "fe-delivery",
  "version": "0.4.0",
  "private": true,
  "description": "Claude Code plugin: governed front-end delivery (scripts have no dependencies).",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs",
    "test:contract": "node --test tests/contract/*.test.mjs",
    "check": "node --check scripts/fe.mjs && node --check scripts/hook.mjs"
  }
}
